[Unit]
Description=Creek Laser Tag game server, Rust (websockets on /run/lasertag/ws.sock; nginx serves it on port 8802)
After=network.target

[Service]
User=lasertag
Group=lasertag
RuntimeDirectory=lasertag
RuntimeDirectoryMode=0755
ExecStart=/opt/lasertag/bin/lasertag-server /run/lasertag/ws.sock
Environment=LASERTAG_WEB=/opt/lasertag/web/laser-tag
Restart=always
RestartSec=2
CPUAffinity=0-5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
MemoryMax=512M

[Install]
WantedBy=multi-user.target
